{
  "name": "mohen-agent-2.0",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @mohen/web dev",
    "build": "pnpm --filter @mohen/web build",
    "lint": "pnpm --filter @mohen/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test-isolated.mjs",
    "test:watch": "vitest",
    "test:raw": "vitest run",
    "test:e2e": "playwright test",
    "guard:docs": "node scripts/check-doc-budget.mjs",
    "guard:structure": "node scripts/check-structure.mjs && node scripts/check-structure-map.mjs",
    "guard:registry": "node scripts/check-production-registry.mjs",
    "guard:source-gate": "node scripts/check-source-gate.mjs",
    "guard:identifiers": "node scripts/check-identifier-registry.mjs",
    "guard:acquisition": "node scripts/check-acquisition-intents.mjs",
    "guard:reconciliation": "node scripts/check-reconciliation.mjs",
    "guard:promotion": "node scripts/check-promotion-gate.mjs",
    "guard:triage": "node scripts/check-review-triage.mjs",
    "guard:escalations": "node scripts/check-escalations.mjs",
    "guard:links": "node scripts/check-links.mjs",
    "guard": "pnpm guard:docs && pnpm guard:structure && pnpm guard:registry && pnpm guard:source-gate && pnpm guard:identifiers && pnpm guard:acquisition && pnpm guard:reconciliation && pnpm guard:promotion && pnpm guard:triage && pnpm guard:escalations && pnpm guard:links && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}