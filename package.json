{
  "name": "mohen-agent-2.0",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @mohen/web dev",
    "build": "pnpm --filter @mohen/web build",
    "lint": "pnpm --filter @mohen/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/test-isolated.mjs",
    "test:watch": "vitest",
    "test:raw": "vitest run",
    "test:e2e": "playwright test",
    "guard:docs": "node scripts/check-doc-budget.mjs",
    "guard:structure": "node scripts/check-structure.mjs && node scripts/check-structure-map.mjs",
    "guard:registry": "node scripts/check-production-registry.mjs",
    "guard:source-gate": "node scripts/check-source-gate.mjs",
    "guard:identifiers": "node scripts/check-identifier-registry.mjs",
    "guard:acquisition": "node scripts/check-acquisition-intents.mjs",
    "guard:reconciliation": "node scripts/check-reconciliation.mjs",
    "guard:naming": "node scripts/check-naming-map.mjs",
    "guard:escalations": "node scripts/check-escalations.mjs",
    "guard:links": "node scripts/check-links.mjs",
    "guard:names": "node scripts/check-name-resolution.mjs",
    "guard": "pnpm guard:docs && pnpm guard:structure && pnpm guard:registry && pnpm guard:source-gate && pnpm guard:identifiers && pnpm guard:acquisition && pnpm guard:reconciliation && pnpm guard:naming && pnpm guard:names && pnpm guard:escalations && pnpm guard:links && pnpm test",
    "data:run": "node pipelines/data-production/run.mjs",
    "guard:registry:v3": "node scripts/guards/check-production-registry.mjs",
    "guard:no-legacy-production-entry": "node scripts/guards/check-no-legacy-production-entry.mjs",
    "guard:stage-handoff": "node scripts/guards/check-stage-handoff.mjs",
    "test:data-production": "node --test tests/data-production/*.test.mjs",
    "guard:physical-model": "node scripts/guards/check-physical-data-model.mjs",
    "test:physical-model": "node --test tests/data-production/physical-model.test.mjs",
    "guard:runtime-boundary": "node scripts/guards/check-runtime-data-boundary.mjs",
    "test:phase-f": "node --test tests/experience/phase-f-alignment.test.mjs",
    "test:phase-g": "node --test tests/end-to-end/phase-g-e2e.test.mjs",
    "guard:e2e-completeness": "node scripts/guards/check-e2e-contract-completeness.mjs",
    "guard:cross-layer-write": "node scripts/guards/check-cross-layer-write-boundary.mjs",
    "guard:gate-enforcement": "node scripts/guards/check-gate-enforcement.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}