{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned Artifact Envelope",
  "type": "object",
  "required": [
    "architecture_generation",
    "artifact_ref",
    "owner_stage",
    "producer_method",
    "definition_ref",
    "source_refs",
    "dependency_snapshot",
    "purpose",
    "scope",
    "limitations",
    "created_at"
  ],
  "properties": {
    "architecture_generation": {
      "const": "mohen.six-stage.v1"
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "owner_stage": {
      "enum": [
        "D00",
        "D01",
        "D02",
        "D03",
        "D04",
        "D05"
      ]
    },
    "producer_method": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "definition_ref": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "dependency_snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "purpose": {
      "type": "object",
      "required": [
        "namespace",
        "code",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "minProperties": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "epistemic_status": {
      "type": "string",
      "minLength": 1
    },
    "lineage_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
