{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent current qualification",
  "type": "object",
  "required": [
    "decision_ref",
    "architecture_generation",
    "gate",
    "artifact_ref",
    "purpose",
    "allowed_scope",
    "consumer",
    "dependency_snapshot",
    "decision",
    "rule_version",
    "reviewer",
    "effective_at",
    "previous_decision_ref"
  ],
  "properties": {
    "decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "architecture_generation": {
      "const": "mohen.six-stage.v1"
    },
    "gate": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5"
      ]
    },
    "artifact_ref": {
      "type": "object",
      "required": [
        "type",
        "id",
        "revision"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "purpose": {
      "type": "object",
      "required": [
        "namespace",
        "code",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "allowed_scope": {
      "type": "object",
      "minProperties": 1
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "dependency_snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision": {
      "enum": [
        "PASS",
        "HOLD",
        "REJECT",
        "REVOKED",
        "UNASSESSED"
      ]
    },
    "rule_version": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "object",
      "required": [
        "id",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "independent-gate-reviewer"
        }
      },
      "additionalProperties": false
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "long_term_basis": {
      "type": "object",
      "required": [
        "rationale",
        "recheck_condition"
      ],
      "properties": {
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "recheck_condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "previous_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "required": [
          "valid_from",
          "evidence_refs"
        ],
        "anyOf": [
          {
            "required": [
              "valid_until"
            ]
          },
          {
            "required": [
              "long_term_basis"
            ]
          }
        ],
        "properties": {
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "minProperties": 1
            }
          }
        }
      }
    }
  ]
}
