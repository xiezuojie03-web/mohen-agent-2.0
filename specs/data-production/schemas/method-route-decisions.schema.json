{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Method Route Decision",
  "type": "object",
  "required": [
    "run_id",
    "architecture_generation",
    "method_id",
    "method_version",
    "input_refs",
    "purpose",
    "consumer",
    "dependency_snapshot",
    "selection",
    "reason_codes"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "architecture_generation": {
      "const": "mohen.six-stage.v1"
    },
    "method_id": {
      "enum": [
        "C01",
        "C02",
        "C03",
        "C04",
        "C05",
        "C06",
        "C07",
        "C08",
        "H01",
        "H02",
        "H03",
        "H04",
        "H05",
        "H06",
        "H07",
        "H08",
        "H09",
        "H10",
        "H11",
        "H12",
        "H13",
        "H14",
        "H15",
        "H16",
        "H17",
        "H18",
        "H19",
        "H20",
        "H21",
        "H22",
        "H23",
        "H24",
        "H25",
        "W01",
        "W02",
        "W03",
        "W04",
        "W05",
        "W06",
        "W07",
        "W08",
        "W09",
        "W10",
        "A01",
        "A02",
        "A03",
        "A04",
        "A05",
        "A06",
        "A07",
        "A08",
        "A09",
        "A10",
        "A11",
        "A12",
        "P01",
        "P02",
        "P03",
        "P04",
        "P05",
        "P06",
        "P07",
        "P08",
        "Y01",
        "Y02",
        "Y03",
        "Y04",
        "Y05",
        "Y06",
        "Y07",
        "Y08"
      ]
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "input_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type",
          "id",
          "revision"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "purpose": {
      "type": "object",
      "required": [
        "namespace",
        "code",
        "version"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "dependency_snapshot": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "selection": {
      "enum": [
        "SELECTED",
        "REJECTED",
        "HOLD"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "profile_ref": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
