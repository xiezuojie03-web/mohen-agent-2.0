@@ -0,0 +1,45 @@
+import {test,expect} from '@playwright/test';
+
+test('Studio keeps the account control clear of the materials shortcut',async({page})=>{
+  await page.route('**/api/session/me',route=>route.fulfill({json:{authenticated:false,user:null}}));
+  await page.goto('/studio');
+  const desk=page.getByRole('link',{name:'资料台',exact:true});
+  const account=page.getByRole('button',{name:'用户',exact:true});
+  const a=await desk.boundingBox(),b=await account.boundingBox();
+  expect(a&&b).toBeTruthy();
+  expect(a!.x>=b!.x+b!.width||b!.x>=a!.x+a!.width||a!.y>=b!.y+b!.height||b!.y>=a!.y+a!.height).toBe(true);
+  await account.click();
+  await expect(page.getByRole('link',{name:'登录',exact:true})).toBeVisible();
+});
+
+test('WATCH explains a revision without chapters and disables playback',async({page})=>{
+  await page.route('**/api/works/published',route=>route.fulfill({json:{works:[{work_id:'synthetic-work',revision_id:'synthetic-revision',title:'缺少章节的合成作品',description:'',revision_no:'1',published_at:'2026-11-02',content:'{}'}]}}));
+  await page.goto('/watch');
+  await expect(page.getByRole('heading',{name:'缺少章节的合成作品',exact:true})).toBeVisible();
+  await expect(page.getByText('此版本尚无可阅读的章节。',{exact:true})).toBeVisible();
+  await expect(page.getByRole('button',{name:'自动翻页',exact:true})).toBeDisabled();
+  await expect(page.getByText('01 / 00',{exact:true})).toHaveCount(0);
+});
+
+test('home restores first-screen mode navigation and direct creation entry',async({page})=>{
+  await page.setViewportSize({width:1440,height:1000});
+  await page.goto('/');
+  await expect(page.getByRole('navigation').getByRole('link',{name:'创作 Studio',exact:true})).toBeVisible();
+  await expect(page.getByRole('link',{name:'开始创作',exact:true})).toBeInViewport();
+  await expect(page.getByRole('link',{name:'自由探索',exact:true})).toBeInViewport();
+  await expect(page.getByRole('region',{name:'从想法到作品'})).toBeVisible();
+  await page.getByRole('link',{name:'开始创作',exact:true}).click();
+  await expect(page).toHaveURL(/\/studio$/);
+});
+
+for (const width of [320,390]) {
+  test(`home keeps account and mode navigation usable at ${width}px`,async({page})=>{
+    await page.setViewportSize({width,height:844});
+    await page.goto('/');
+    await expect(page.getByRole('button',{name:'用户',exact:true})).toBeInViewport();
+    await expect(page.getByRole('navigation').getByRole('link',{name:'探索 EXP',exact:true})).toBeInViewport();
+    expect(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth)).toBe(true);
+    await page.getByRole('button',{name:'用户',exact:true}).click();
+    await expect(page.getByRole('link',{name:'登录',exact:true})).toBeInViewport();
+  });
+}
