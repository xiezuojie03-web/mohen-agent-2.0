# Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_APP_NAME=墨痕 Agent 2.0

# --- 认证（P0 安全止血 2026-10-29）---
# 注意：Next.js 只读取 apps/web/.env.local（middleware 需要 AUTH_SECRET）；仓库根 .env.local 供脚本/生产链使用。
# 必填：>=32 字符随机串；未配置时登录/注册/鉴权一律返回 503（fail-closed，不再有默认密钥）。
AUTH_SECRET=
# 找回密码：仅在已完成邮箱服务/受保护研发验证的环境启用。
MOHEN_PASSWORD_RESET_ENABLED=false
MOHEN_QQ_SMTP_AUTH_CODE=
MOHEN_AUTH_MAIL_FROM=
# HTTPS站点origin；受保护Preview可留空，使用平台注入VERCEL_URL。
MOHEN_AUTH_PUBLIC_ORIGIN=
# 注册模式：open=开放注册；invite=邀请制；closed=关闭。当前未公开，默认 open。
MOHEN_REGISTRATION_MODE=open
# 邀请制注册：只有持此邀请码的人能注册；留空 = 关闭注册。
MOHEN_INVITE_CODE=
# Owner 首次开通（可选）：邮箱 + 一次性令牌同时匹配才授予四角色；不配置则不启用。
OWNER_EMAIL=
OWNER_SETUP_TOKEN=

# Optional external capabilities. Leave blank until a task explicitly needs them.
SHANGHAI_LIBRARY_KEY=
AMAP_WEB_KEY=
DEEPSEEK_API_KEY=

# Raw store stays local-first in Phase 0.
MOHEN_RAW_STORE_PATH=D:/MoHen/data/raw

# Candidate HP02: enable only after approved session-revocation migration and tests.
# After activation, disabling this check can resurrect revoked cookies. Keep off
# in production until separately authorized; rollback must preserve revocations.
MOHEN_REVOCABLE_SESSIONS_ENABLED=false

# Protected Preview execution profile. Keep OFF until independent services and
# real low-privilege LOGINs have been verified. These are placeholders only.
# Producer/executor must never receive a Gate signer URL or private signing key.
MOHEN_CLOUD_EXECUTION_ENABLED=false
MOHEN_CLOUD_EXECUTOR_URL=
MOHEN_CLOUD_EXECUTOR_CREDENTIAL=
MOHEN_PRODUCER_DATABASE_URL=
MOHEN_PRIVATE_WORKER_DATABASE_URL=
MOHEN_EXECUTION_AUTH_PUBLIC_KEY=
MOHEN_EXECUTION_AUTH_VERIFY_URL=
MOHEN_EXECUTION_AUTH_VERIFY_CREDENTIAL=
MOHEN_EXECUTION_AUTH_DYNAMIC_URL=
MOHEN_EXECUTION_AUTH_DYNAMIC_CREDENTIAL=
MOHEN_INDEPENDENT_GATE_VERIFY_URL=
MOHEN_INDEPENDENT_GATE_VERIFY_CREDENTIAL=
# 跨阶段运行：job_id -> 读凭据 的 JSON 映射（Gate 消费凭据按 job/gate 绑定）
MOHEN_INDEPENDENT_GATE_VERIFY_CREDENTIALS=
MOHEN_SUPABASE_URL=
MOHEN_PRIVATE_STORAGE_SERVICE_KEY=
MOHEN_ORIGINAL_BRIDGE_SECRET=
MOHEN_ORIGINAL_BRIDGE_KEY_VERSION=
